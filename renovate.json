{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Axios release notes include an advisory proof of concept that secret scanning flags.",
      "matchPackageNames": ["axios"],
      "fetchReleaseNotes": false
    }
  ]
}
